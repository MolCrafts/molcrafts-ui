{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    ".storybook/**/*.ts",
    "packages/web-components/src/**/*.ts",
    "packages/web-components/rslib.config.ts",
    "playwright.config.ts",
    "tests/web-components/**/*.ts"
  ]
}
