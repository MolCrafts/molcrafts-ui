{
  "name": "@molcrafts/web-components",
  "version": "0.0.1",
  "description": "Framework-independent MolCrafts Fluent 2 Web Components",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./theme.css": "./dist/theme.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./browser.js": "./dist/browser/browser.js"
  },
  "sideEffects": [
    "**/register.js",
    "**/*.css",
    "**/browser.js"
  ],
  "dependencies": {
    "@fluentui/web-components": "3.1.3",
    "@microsoft/fast-element": "3.1.0",
    "@microsoft/focusgroup-polyfill": "1.6.0",
    "@molcrafts/tokens": "workspace:*"
  },
  "customElements": "./dist/custom-elements.json",
  "private": true,
  "devDependencies": {
    "@rslib/core": "1.0.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  }
}
