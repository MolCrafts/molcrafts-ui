{
  "name": "@molcrafts/ui-web-components",
  "version": "0.1.0-alpha.0",
  "description": "Framework-independent MolCrafts Fluent 2 Web Components",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./theme.css": "./dist/theme.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./browser.js": "./dist/browser/browser.js"
  },
  "sideEffects": [
    "**/register.js",
    "**/*.css",
    "**/browser.js"
  ],
  "dependencies": {
    "@fluentui/web-components": "3.1.3",
    "@microsoft/fast-element": "3.1.0",
    "@microsoft/focusgroup-polyfill": "1.6.0",
    "@molcrafts/ui-tokens": "workspace:*"
  },
  "customElements": "./dist/custom-elements.json",
  "devDependencies": {
    "@rslib/core": "1.0.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MolCrafts/molcrafts-ui.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/MolCrafts/molcrafts-ui#readme",
  "bugs": {
    "url": "https://github.com/MolCrafts/molcrafts-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
