{
  "name": "@molcrafts/ui-vega",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Optional MolCrafts vega React chart adapter",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/scienceplots.d.ts",
      "import": "./dist/scienceplots.js"
    },
    "./view": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@molcrafts/ui-tokens": "workspace:*",
    "vega": "6.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "1.0.3",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MolCrafts/molcrafts-ui.git",
    "directory": "packages/vega"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
