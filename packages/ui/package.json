{
  "version": "0.1.0-alpha.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "name": "@molcrafts/design",
  "description": "MolCrafts reusable React components",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@molcrafts/design-tokens": "workspace:*",
    "@fluentui/react-icons": "2.0.344",
    "@radix-ui/react-accordion": "1.2.21",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-collapsible": "1.1.21",
    "@radix-ui/react-context-menu": "2.3.8",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-scroll-area": "1.3.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "react-resizable-panels": "4.14.3",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "1.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "@rsbuild/plugin-react": "2.1.1"
  },
  "scripts": {
    "build": "rslib build && node ../../scripts/build-ui-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MolCrafts/molcrafts-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/MolCrafts/molcrafts-ui#readme",
  "bugs": {
    "url": "https://github.com/MolCrafts/molcrafts-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
