{
  "name": "@molcrafts/ui-markdown",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Token-styled Markdown with GFM and KaTeX for MolCrafts products",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "clsx": "2.1.1",
    "katex": "0.17.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "2.1.1",
    "@rslib/core": "1.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MolCrafts/molcrafts-ui.git",
    "directory": "packages/markdown"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
