{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "molcrafts",
  "homepage": "https://github.com/MolCrafts/molcrafts-ui",
  "items": [
    {
      "name": "setup",
      "type": "registry:style",
      "title": "MolCrafts package styles",
      "description": "Install canonical package CSS; no component source copying.",
      "dependencies": [
        "@molcrafts/ui",
        "@molcrafts/ui-tokens"
      ],
      "files": [
        {
          "path": "registry/setup.css",
          "type": "registry:style"
        }
      ]
    },
    {
      "name": "button-example",
      "type": "registry:example",
      "title": "Accessible icon action",
      "description": "Compose public MolCrafts components with official Fluent icons.",
      "dependencies": [
        "@molcrafts/ui",
        "@fluentui/react-icons"
      ],
      "registryDependencies": [
        "setup"
      ],
      "files": [
        {
          "path": "registry/button-example.tsx",
          "type": "registry:component"
        }
      ]
    }
  ]
}
